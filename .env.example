# Smart Trader Assistant — environment variables
# Copy this file to `.env` and fill in real values from your Supabase project.
# `.env` is git-ignored. Never commit real secrets.

# ── Public (bundled into client; safe to commit when empty) ────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ── Optional: added in later milestones ────────────────────────────────────
# VITE_SENTRY_DSN=
# VITE_ANALYTICS_ID=

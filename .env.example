# Smart Trader Assistant — environment variables
# Copy this file to `.env` and fill in real values from your Supabase project.
# `.env` is git-ignored. Never commit real secrets.

# ── Public (bundled into client; safe to commit when empty) ────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ── M8: Stripe & Custom Domain ─────────────────────────────────────────────
# Publishable key + price for the $20/mo plan (public, safe to expose)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key
VITE_STRIPE_PRICE_ID=price_your-monthly-price-id
# Payment UI mode: dual (Stripe + Whish/OMT) is default in M8; stripe hides manual.
# Allowed: dual | stripe | manual
VITE_PAYMENT_MODE=dual
# Canonical app URL for Stripe success/cancel redirects
VITE_APP_URL=https://smart-tajir.com
# IQD peg rate — IQD per 1 USD (Central Bank reference). Used for display conversion only.
VITE_IQD_PEG=1310

# ── Server-only (Supabase Edge Function secrets — NEVER prefix with VITE_) ───
# Set via: supabase secrets set STRIPE_SECRET_KEY=sk_... STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_SECRET_KEY=sk_test_your-secret-key
# STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Optional: added in later milestones ────────────────────────────────────
# VITE_SENTRY_DSN=
# VITE_ANALYTICS_ID=
